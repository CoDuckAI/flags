{
  "name": "@coduck/flags-openfeature",
  "version": "0.1.0",
  "description": "OpenFeature provider for CoDuck Flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoDuckAI/flags.git",
    "directory": "packages/openfeature"
  },
  "homepage": "https://github.com/CoDuckAI/flags#readme",
  "bugs": {
    "url": "https://github.com/CoDuckAI/flags/issues"
  },
  "keywords": [
    "feature-flags",
    "rollout",
    "openfeature",
    "provider"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --external @openfeature/server-sdk",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "dependencies": {
    "@coduck/flags": "workspace:*"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": ">=1.20.0 <2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
