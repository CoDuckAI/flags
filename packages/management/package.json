{
  "name": "@coduck/flags-management",
  "version": "0.1.0",
  "description": "Headless management SDK for CoDuck Flags",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoDuckAI/flags.git",
    "directory": "packages/management"
  },
  "homepage": "https://github.com/CoDuckAI/flags#readme",
  "bugs": {
    "url": "https://github.com/CoDuckAI/flags/issues"
  },
  "keywords": [
    "feature-flags",
    "rollout",
    "management-sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "publint": "publint"
  },
  "dependencies": {
    "@coduck/flags-core": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
